{
  "expo": {
    "name": "Vén",
    "slug": "ven-finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ven.finance",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Vén dùng Face ID để mở khóa nhanh dữ liệu tài chính của bạn."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F6E5B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ven.finance",
      "versionCode": 1,
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT", "VIBRATE", "RECEIVE_BOOT_COMPLETED"],
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#F7F5F0"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0F6E5B"
        }
      ]
    ]
  }
}
